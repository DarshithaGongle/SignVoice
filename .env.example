# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your keys never get committed.

# RapidAPI key for the English -> Hindi translation used by "Speak" (Google Translate 113 API).
# Get one free at https://rapidapi.com/ -> subscribe to "Google Translate 113" -> copy your X-RapidAPI-Key.
RAPIDAPI_KEY=your-rapidapi-key-here

# Django secret key. Optional for local dev (a random one is used if left blank).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
